<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FocusTrace.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FocusTrace"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="LayoutRoot">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="NarrowLayout" />
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderControls.(Grid.Row)" Value="0" />
                        <Setter Target="HeaderControls.(Grid.Column)" Value="1" />
                        <Setter Target="HeaderControls.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="HeaderControls.Margin" Value="0" />
                        <Setter Target="SwitchCard.(Grid.Row)" Value="0" />
                        <Setter Target="SwitchCard.(Grid.Column)" Value="0" />
                        <Setter Target="SwitchCard.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="RateCard.(Grid.Row)" Value="0" />
                        <Setter Target="RateCard.(Grid.Column)" Value="1" />
                        <Setter Target="RateCard.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="StreakCard.(Grid.Row)" Value="0" />
                        <Setter Target="StreakCard.(Grid.Column)" Value="2" />
                        <Setter Target="StreakCard.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="RecentPanel.(Grid.Row)" Value="0" />
                        <Setter Target="RecentPanel.(Grid.Column)" Value="0" />
                        <Setter Target="AppsPanel.(Grid.Row)" Value="0" />
                        <Setter Target="AppsPanel.(Grid.Column)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer>
            <StackPanel
                MaxWidth="1120"
                Padding="32,24,32,40"
                HorizontalAlignment="Stretch"
                Spacing="20">

                <Grid
                    x:Name="HeaderGrid"
                    ColumnSpacing="16"
                    RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock
                            Style="{ThemeResource TitleTextBlockStyle}"
                            Text="Your focus, made visible" />
                        <TextBlock
                            MaxWidth="620"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="FocusTrace observes active app changes while you are using your PC, helping you notice—and reduce—context switching."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel
                        x:Name="HeaderControls"
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Margin="0,4,0,0"
                        Orientation="Horizontal"
                        Spacing="16">
                        <ComboBox
                            x:Name="ThemeComboBox"
                            Width="120"
                            Header="Theme"
                            AutomationProperties.Name="Application theme"
                            SelectionChanged="ThemeComboBox_SelectionChanged">
                            <ComboBoxItem Content="System" Tag="System" />
                            <ComboBoxItem Content="Light" Tag="Light" />
                            <ComboBoxItem Content="Dark" Tag="Dark" />
                        </ComboBox>
                        <ToggleSwitch
                            x:Name="TrackingToggle"
                            Header="Tracking"
                            IsOn="True"
                            AutomationProperties.HelpText="Pause or resume active application switch tracking"
                            AutomationProperties.Name="Context switch tracking"
                            Toggled="TrackingToggle_Toggled" />
                    </StackPanel>
                </Grid>

                <InfoBar
                    x:Name="PrivacyInfoBar"
                    IsClosable="True"
                    IsOpen="True"
                    Message="App names and timing stay on this device. Window titles, keystrokes, and screen content are never captured."
                    Severity="Informational"
                    Title="Private by design" />

                <CommandBar
                    DefaultLabelPosition="Right"
                    IsDynamicOverflowEnabled="True"
                    AutomationProperties.Name="Focus actions">
                    <AppBarButton
                        x:Name="StartFocusButton"
                        Click="StartFocusButton_Click"
                        Icon="Play"
                        Label="Start 25-minute focus" />
                    <AppBarButton
                        x:Name="StopFocusButton"
                        Click="StopFocusButton_Click"
                        Icon="Stop"
                        IsEnabled="False"
                        Label="End focus session" />
                    <AppBarToggleButton
                        x:Name="MeetingFocusButton"
                        Checked="MeetingFocusButton_Checked"
                        Icon="Contact"
                        Label="Meeting focus"
                        Unchecked="MeetingFocusButton_Unchecked" />
                    <CommandBar.SecondaryCommands>
                        <AppBarButton
                            Click="ResetTodayButton_Click"
                            Icon="Delete"
                            Label="Reset today" />
                    </CommandBar.SecondaryCommands>
                </CommandBar>

                <InfoBar
                    x:Name="WindowAlertInfoBar"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Warning"
                    Title="Too many windows competing for attention" />

                <InfoBar
                    x:Name="MeetingInfoBar"
                    IsClosable="False"
                    IsOpen="False"
                    Message="Stay present: keep the meeting as your primary task and park unrelated work until it ends."
                    Severity="Informational"
                    Title="Meeting Focus is on" />

                <InfoBar
                    x:Name="AwardInfoBar"
                    IsClosable="True"
                    IsOpen="False"
                    Severity="Success"
                    Title="New personal best!" />

                <InfoBar
                    x:Name="FocusSessionInfoBar"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Success"
                    Title="Focus session active">
                    <InfoBar.Content>
                        <StackPanel Spacing="8">
                            <TextBlock
                                x:Name="FocusTimeRemainingText"
                                Style="{ThemeResource SubtitleTextBlockStyle}"
                                Text="25:00 remaining" />
                            <ProgressBar
                                x:Name="FocusProgressBar"
                                Maximum="1500"
                                AutomationProperties.Name="Focus session progress" />
                        </StackPanel>
                    </InfoBar.Content>
                </InfoBar>

                <Grid
                    x:Name="MetricGrid"
                    ColumnSpacing="12"
                    RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        x:Name="SwitchCard"
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Style="{StaticResource MetricCardStyle}">
                        <StackPanel Spacing="6">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="SWITCHES TODAY" />
                            <TextBlock
                                x:Name="SwitchCountText"
                                Style="{ThemeResource TitleLargeTextBlockStyle}"
                                Text="0" />
                            <TextBlock
                                x:Name="SwitchTrendText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Tracking started" />
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="RateCard"
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Style="{StaticResource MetricCardStyle}">
                        <StackPanel Spacing="6">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="SWITCHES / ACTIVE HOUR" />
                            <TextBlock
                                x:Name="SwitchRateText"
                                Style="{ThemeResource TitleLargeTextBlockStyle}"
                                Text="0.0" />
                            <TextBlock
                                x:Name="FocusScoreText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Focus score 100" />
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="StreakCard"
                        Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Style="{StaticResource MetricCardStyle}">
                        <StackPanel Spacing="6">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="CURRENT FOCUS STREAK" />
                            <TextBlock
                                x:Name="FocusStreakText"
                                Style="{ThemeResource TitleLargeTextBlockStyle}"
                                Text="0m" />
                            <TextBlock
                                x:Name="BestStreakText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Best today 0m" />
                        </StackPanel>
                    </Border>
                </Grid>

                <InfoBar
                    x:Name="InsightInfoBar"
                    IsClosable="False"
                    IsOpen="True"
                    Severity="Informational"
                    Title="Focus insight" />

                <StackPanel Spacing="10">
                    <TextBlock
                        Style="{ThemeResource SubtitleTextBlockStyle}"
                        Text="Focus trends" />
                    <TextBlock
                        x:Name="TrendSummaryText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Trend analysis begins after FocusTrace has collected a few work sessions."
                        TextWrapping="Wrap" />
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Enabled"
                        VerticalScrollBarVisibility="Disabled"
                        VerticalScrollMode="Disabled"
                        ZoomMode="Disabled">
                        <Grid
                            x:Name="FocusHeatmapGrid"
                            MinWidth="850"
                            AutomationProperties.Name="Focus score heat map by weekday and time of day" />
                    </ScrollViewer>
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Less focused" />
                        <Border
                            Width="22"
                            Height="10"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="3"
                            Opacity="0.2" />
                        <Border
                            Width="22"
                            Height="10"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="3"
                            Opacity="0.45" />
                        <Border
                            Width="22"
                            Height="10"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="3"
                            Opacity="0.7" />
                        <Border
                            Width="22"
                            Height="10"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="3" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="More focused" />
                    </StackPanel>
                </StackPanel>

                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="4">
                            <TextBlock
                                Style="{ThemeResource SubtitleTextBlockStyle}"
                                Text="Weekly report" />
                            <TextBlock
                                x:Name="WeeklyReportSummaryText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Your first weekly comparison is being prepared."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="ACTIVE TIME" />
                                <TextBlock
                                    x:Name="WeeklyActiveTimeText"
                                    Style="{ThemeResource SubtitleTextBlockStyle}"
                                    Text="0s" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="1"
                                Spacing="2">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="SWITCHES" />
                                <TextBlock
                                    x:Name="WeeklySwitchesText"
                                    Style="{ThemeResource SubtitleTextBlockStyle}"
                                    Text="0" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="2"
                                Spacing="2">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="FOCUS BLOCKS" />
                                <TextBlock
                                    x:Name="WeeklyFocusBlocksText"
                                    Style="{ThemeResource SubtitleTextBlockStyle}"
                                    Text="0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid
                    ColumnSpacing="20"
                    RowSpacing="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        x:Name="RecentPanel"
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Spacing="10">
                        <TextBlock
                            Style="{ThemeResource SubtitleTextBlockStyle}"
                            Text="Recent context switches" />
                        <ListView
                            x:Name="RecentSwitchesList"
                            MaxHeight="280"
                            AutomationProperties.Name="Recent context switches"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid
                                        MinHeight="44"
                                        Padding="4"
                                        ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Text="{Binding AppName}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Time}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <StackPanel
                        x:Name="AppsPanel"
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Spacing="10">
                        <TextBlock
                            Style="{ThemeResource SubtitleTextBlockStyle}"
                            Text="Open apps now" />
                        <ListView
                            x:Name="TopAppsList"
                            MaxHeight="280"
                            AutomationProperties.Name="Currently open applications"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid
                                        MinHeight="52"
                                        Padding="4"
                                        ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding AppName}" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Detail}" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Windows}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Grid>

                <Expander Header="FocusTrace settings">
                    <StackPanel
                        Padding="0,12,0,4"
                        Spacing="16">
                        <NumberBox
                            x:Name="WindowThresholdBox"
                            Header="Window alert threshold"
                            Description="Alert when more than this many visible windows are open."
                            Minimum="3"
                            Maximum="50"
                            SmallChange="1"
                            SpinButtonPlacementMode="Compact"
                            ValueChanged="WindowThresholdBox_ValueChanged" />
                        <StackPanel Spacing="8">
                            <TextBox
                                x:Name="ExcludedAppsTextBox"
                                Header="Excluded apps"
                                PlaceholderText="Example: Slack, Microsoft Outlook"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Separate app names with commas. Excluded apps do not add active time or context switches."
                                TextWrapping="Wrap" />
                            <Button
                                HorizontalAlignment="Left"
                                Click="SaveExclusionsButton_Click"
                                Content="Save exclusions" />
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <ComboBox
                                x:Name="MeetingKeepAppComboBox"
                                Header="Keep visible during Meeting Focus"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="MeetingKeepAppComboBox_SelectionChanged" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="When Meeting Focus starts, other visible windows are minimized. If the selected app is not open, no windows are changed."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="10">
                            <ToggleSwitch
                                x:Name="InactiveScheduleToggle"
                                Header="Inactive schedule"
                                OffContent="Track normally"
                                OnContent="Pause during selected times"
                                Toggled="InactiveScheduleToggle_Toggled" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TimePicker
                                    x:Name="InactiveStartTimePicker"
                                    Header="Pause from"
                                    MinuteIncrement="15"
                                    TimeChanged="InactiveTimePicker_TimeChanged" />
                                <TimePicker
                                    x:Name="InactiveEndTimePicker"
                                    Grid.Column="1"
                                    Header="Resume at"
                                    MinuteIncrement="15"
                                    TimeChanged="InactiveTimePicker_TimeChanged" />
                            </Grid>
                            <TextBlock
                                Text="Inactive days"
                                Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <ScrollViewer
                                HorizontalScrollBarVisibility="Auto"
                                HorizontalScrollMode="Enabled"
                                VerticalScrollBarVisibility="Disabled"
                                VerticalScrollMode="Disabled">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ToggleButton
                                        x:Name="InactiveMondayButton"
                                        Checked="InactiveDayButton_Changed"
                                        Content="Mon"
                                        Unchecked="InactiveDayButton_Changed" />
                                    <ToggleButton
                                        x:Name="InactiveTuesdayButton"
                                        Checked="InactiveDayButton_Changed"
                                        Content="Tue"
                                        Unchecked="InactiveDayButton_Changed" />
                                    <ToggleButton
                                        x:Name="InactiveWednesdayButton"
                                        Checked="InactiveDayButton_Changed"
                                        Content="Wed"
                                        Unchecked="InactiveDayButton_Changed" />
                                    <ToggleButton
                                        x:Name="InactiveThursdayButton"
                                        Checked="InactiveDayButton_Changed"
                                        Content="Thu"
                                        Unchecked="InactiveDayButton_Changed" />
                                    <ToggleButton
                                        x:Name="InactiveFridayButton"
                                        Checked="InactiveDayButton_Changed"
                                        Content="Fri"
                                        Unchecked="InactiveDayButton_Changed" />
                                    <ToggleButton
                                        x:Name="InactiveSaturdayButton"
                                        Checked="InactiveDayButton_Changed"
                                        Content="Sat"
                                        Unchecked="InactiveDayButton_Changed" />
                                    <ToggleButton
                                        x:Name="InactiveSundayButton"
                                        Checked="InactiveDayButton_Changed"
                                        Content="Sun"
                                        Unchecked="InactiveDayButton_Changed" />
                                </StackPanel>
                            </ScrollViewer>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="For overnight ranges, the inactive period continues into the next morning."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="CalendarDetectionToggle"
                            Header="Calendar-aware meeting detection"
                            OffContent="Off"
                            OnContent="On"
                            Toggled="CalendarDetectionToggle_Toggled" />
                        <TextBlock
                            x:Name="CalendarStatusText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Calendar detection checks only whether a meeting is active or imminent."
                            TextWrapping="Wrap" />
                        <ToggleSwitch
                            x:Name="TrayModeToggle"
                            Header="Keep tracking in the notification area"
                            OffContent="Closing exits FocusTrace"
                            OnContent="Closing hides FocusTrace"
                            Toggled="TrayModeToggle_Toggled" />
                        <ToggleSwitch
                            x:Name="StartupLaunchToggle"
                            Header="Launch when I sign in"
                            OffContent="Off"
                            OnContent="Starts quietly in the notification area"
                            Toggled="StartupLaunchToggle_Toggled" />
                        <TextBlock
                            x:Name="StartupStatusText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Checking Windows startup status…"
                            TextWrapping="Wrap" />
                        <ToggleSwitch
                            x:Name="NotificationToggle"
                            Header="Windows alerts"
                            OffContent="In-app alerts only"
                            OnContent="Notification Center and tray alerts"
                            Toggled="NotificationToggle_Toggled" />
                        <StackPanel Spacing="8">
                            <TextBlock
                                Text="Data management"
                                Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <Button
                                HorizontalAlignment="Left"
                                Click="ResetAllDataButton_Click"
                                Content="Reset all focus data" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Clears all history, trends, streak records, and focus sessions. Your settings remain."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <TextBlock
                    x:Name="TrackingStatusText"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Tracking active apps while you are working."
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
